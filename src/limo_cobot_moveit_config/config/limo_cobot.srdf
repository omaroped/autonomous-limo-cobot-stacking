<?xml version="1.0" encoding="UTF-8"?>
<robot name="limo_ackermann">
    <group name="arm">
        <chain base_link="joint1" tip_link="gripper_tcp"/>
    </group>
    <group name="gripper">
        <joint name="gripper_controller"/>
    </group>

    <passive_joint name="gripper_base_to_gripper_left2"/>
    <passive_joint name="gripper_left3_to_gripper_left1"/>
    <passive_joint name="gripper_base_to_gripper_right3"/>
    <passive_joint name="gripper_base_to_gripper_right2"/>
    <passive_joint name="gripper_right3_to_gripper_right1"/>

    <group_state name="home" group="arm">
        <joint name="joint2_to_joint1" value="0.0"/>
        <joint name="joint3_to_joint2" value="0.0"/>
        <joint name="joint4_to_joint3" value="0.0"/>
        <joint name="joint5_to_joint4" value="0.0"/>
        <joint name="joint6_to_joint5" value="0.0"/>
        <joint name="joint6output_to_joint6" value="0.0"/>
    </group_state>
    <group_state name="ready" group="arm">
        <joint name="joint2_to_joint1" value="0.0"/>
        <joint name="joint3_to_joint2" value="-0.5"/>
        <joint name="joint4_to_joint3" value="-0.6"/>
        <joint name="joint5_to_joint4" value="1.1"/>
        <joint name="joint6_to_joint5" value="0.0"/>
        <joint name="joint6output_to_joint6" value="0.0"/>
    </group_state>
    <group_state name="gripper_open" group="gripper">
        <joint name="gripper_controller" value="0.15"/>
    </group_state>
    <group_state name="gripper_closed" group="gripper">
        <joint name="gripper_controller" value="-0.5"/>
    </group_state>

    <end_effector name="gripper" parent_link="gripper_tcp" group="gripper" parent_group="arm"/>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>

    <disable_collisions link1="base_link" link2="depth_camera_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="front_left_steer_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="front_left_wheel_link" reason="Default"/>
    <disable_collisions link1="base_link" link2="front_right_steer_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="front_right_wheel_link" reason="Default"/>
    <disable_collisions link1="base_link" link2="imu_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="joint1" reason="Default"/>
    <disable_collisions link1="base_link" link2="joint2" reason="Never"/>
    <disable_collisions link1="base_link" link2="laser_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="rear_left_wheel_link" reason="Adjacent"/>
