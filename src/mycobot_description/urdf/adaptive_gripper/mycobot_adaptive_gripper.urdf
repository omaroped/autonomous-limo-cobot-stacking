<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mycobot_gripper">
    <xacro:property name="width" value=".2" />

    <link name="gripper_base">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_base.dae"/>
        </geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_base_col.dae"/></geometry>
        <origin xyz="0.0 0 -0.012" rpy="0 0 3.14159"/>
      </collision>
    </link>

    <link name="gripper_left1">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left1.dae"/>
        </geometry>
        <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </visual>
      <collision name="col">
        <geometry><mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left1_col.dae"/></geometry>
        <origin xyz="0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_left2">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left2.dae"/>
        </geometry>
        <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left2_col.dae"/></geometry>
        <origin xyz="0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_left3">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left3.dae"/>
        </geometry>
        <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_left3_col.dae"/></geometry>
        <origin xyz="0.012 0.0025 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_right1">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right1.dae"/>
        </geometry>
        <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </visual>
      <collision name="col">
        <geometry><mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right1_col.dae"/></geometry>
        <origin xyz="-0.039 -0.0133 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_right2">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right2.dae"/>
        </geometry>
        <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right2_col.dae"/></geometry>
        <origin xyz="-0.005 -0.0195 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <link name="gripper_right3">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right3.dae"/>
        </geometry>
        <origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/>
      </visual>
      <collision>
        <geometry><mesh filename="package://mycobot_description/urdf/adaptive_gripper/gripper_right3_col.dae"/></geometry>
        <origin xyz="-0.012 0.0025 -0.012" rpy="0 0 0"/>
      </collision>
    </link>

    <joint name="gripper_controller" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="8.0" lower="-0.7" upper="0.15" velocity="1.0"/>
      <parent link="gripper_base"/>
      <child link="gripper_left3"/>
      <origin xyz="-0.012 0.005 0" rpy="0 0 0"/>
    </joint>

    <joint name="gripper_base_to_gripper_left2" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="8.0" lower="-0.8" upper="0.5" velocity="1.0"/>
      <parent link="gripper_base"/>
      <child link="gripper_left2"/>
      <origin xyz="-0.005 0.027 0" rpy="0 0 0"/>
    </joint>

    <joint name="gripper_left3_to_gripper_left1" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="8.0" lower="-0.5" upper="0.5" velocity="1.0"/>
      <parent link="gripper_left3"/>
      <child link="gripper_left1"/>
      <origin xyz="-0.027 0.016 0" rpy="0 0 0"/>
    </joint>

    <joint name="gripper_base_to_gripper_right3" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="8.0" lower="-0.15" upper="0.7" velocity="1.0"/>
      <parent link="gripper_base"/>
      <child link="gripper_right3"/>
      <origin xyz="0.012 0.005 0" rpy="0 0 0"/>
    </joint>

    <joint name="gripper_base_to_gripper_right2" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="8.0" lower="-0.5" upper="0.8" velocity="1.0"/>
      <parent link="gripper_base"/>
      <child link="gripper_right2"/>
      <origin xyz="0.005 0.027 0" rpy="0 0 0"/>
    </joint>

    <joint name="gripper_right3_to_gripper_right1" type="revolute">
      <axis xyz="0 0 1"/>
      <limit effort="8.0" lower="-0.5" upper="0.5" velocity="1.0"/>
      <parent link="gripper_right3"/>
      <child link="gripper_right1"/>
      <origin xyz="0.027 0.016 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="gripper_left1">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <maxVel>0.01</maxVel>
      <minDepth>0.001</minDepth>
      <self_collide>0</self_collide>
      <sensor name="gripper_left1_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>col</collision>
        </contact>
        <plugin name="gripper_left1_bumper" filename="libgazebo_ros_bumper.so">
          <ros>
            <remapping>bumper_states:=gripper_left1_bumper</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </gazebo>
    <gazebo reference="gripper_right1">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <maxVel>0.01</maxVel>
      <minDepth>0.001</minDepth>
      <self_collide>0</self_collide>
      <sensor name="gripper_right1_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <contact>
          <collision>col</collision>
        </contact>
        <plugin name="gripper_right1_bumper" filename="libgazebo_ros_bumper.so">
          <ros>
            <remapping>bumper_states:=gripper_right1_bumper</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo reference="gripper_base">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <maxVel>0.01</maxVel>
      <minDepth>0.001</minDepth>
      <self_collide>0</self_collide>
    </gazebo>
    <gazebo reference="gripper_left2">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <maxVel>0.01</maxVel>
      <minDepth>0.001</minDepth>
      <self_collide>0</self_collide>
    </gazebo>
    <gazebo reference="gripper_left3">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <maxVel>0.01</maxVel>
      <minDepth>0.001</minDepth>
      <self_collide>0</self_collide>
    </gazebo>
    <gazebo reference="gripper_right2">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <maxVel>0.01</maxVel>
      <minDepth>0.001</minDepth>
      <self_collide>0</self_collide>
    </gazebo>
    <gazebo reference="gripper_right3">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1e6</kp>
      <kd>100.0</kd>
      <maxVel>0.01</maxVel>
      <minDepth>0.001</minDepth>
      <self_collide>0</self_collide>
    </gazebo>

  </xacro:macro>
</robot>
